rules_version = '2';

// audio/{regCode}/... 경로 자체가 등록 코드로 잠겨 있으므로
// 로그인만 되어 있으면(익명 포함) 읽기는 허용하고,
// 쓰기(업로드)는 루루만 하도록 막는다.
// 업로드는 obs/index.html에서 루루가 로그인한 상태로만 실행된다.

service firebase.storage {
  match /b/{bucket}/o {
    match /audio/{code}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'LULU_EMAIL_여기에_입력';
    }
  }
}
